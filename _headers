# Cloudflare Pages headers file.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Security + sensible defaults for all routes
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Long-cache immutable, content-hashed-style static assets (images rarely change)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should always be revalidated so content edits go live immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fonts never change once shipped
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Rewards data refreshes daily; 5-minute edge cache is plenty
/rewards-data/*
  Cache-Control: public, max-age=300

/rewards-archive/*
  Cache-Control: public, max-age=86400, immutable

# JS must never outlive the HTML that references it (auditor 2026-08-24
# item 2: JS was 4h-cached while HTML revalidates -> up to 4h of new-page/
# old-code after every deploy; the stake tile stuck on its placeholder was
# this). Files are 1-3KB; the cost is a 304 per load.
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/rewards.js
  Cache-Control: public, max-age=0, must-revalidate
/band.js
  Cache-Control: public, max-age=0, must-revalidate
